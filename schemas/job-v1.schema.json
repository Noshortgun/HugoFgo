{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Noshortgun/HugoFgo/blob/main/schemas/job-v1.schema.json",
  "title": "HugoFgo job v1",
  "type": "object",
  "required": ["version", "mysticId", "enemyCount", "formation", "strategy", "waves"],
  "additionalProperties": false,
  "$defs": {
    "slot": { "type": "integer", "minimum": 0, "maximum": 5 },
    "cardColor": { "enum": ["buster", "arts", "quick"] },
    "skillTarget": { "enum": ["self", "ally", "allAllies", "enemy", "allEnemies"] },
    "secondaryType": { "enum": ["selectAddInfo", "noblePhantasmCardType", "criticalStarConsumption"] },
    "secondaryOption": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": ["string", "number"] },
        "label": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "secondarySelection": {
      "type": "object",
      "required": ["type", "index", "value", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/secondaryType" },
        "index": { "type": "integer", "minimum": 0 },
        "value": { "type": ["string", "number"] },
        "label": { "type": "string" },
        "imageUrl": { "type": "string" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/secondaryOption" } }
      }
    },
    "formationSlot": {
      "type": "object",
      "required": ["slot", "name"],
      "additionalProperties": false,
      "properties": {
        "slot": { "$ref": "#/$defs/slot" },
        "svtId": { "type": "integer" },
        "limitCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "npId": { "type": "integer" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "support": { "type": "boolean" },
        "supportRequired": { "type": "boolean" },
        "grandRequired": { "type": "boolean" },
        "ce": { "type": "string" },
        "ceId": { "type": "integer" },
        "grandCe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": ["string", "null"] },
            "middle": { "type": ["string", "null"] },
            "bottom": { "type": ["string", "null"] }
          }
        },
        "grandCeIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": ["integer", "null"] },
            "middle": { "type": ["integer", "null"] },
            "bottom": { "type": ["integer", "null"] }
          }
        }
      }
    },
    "fallbackStrategy": {
      "type": "object",
      "required": ["allowNp", "servantOrder", "cards", "colorPriority", "strategyOrder"],
      "additionalProperties": false,
      "properties": {
        "allowNp": { "type": "boolean" },
        "servantOrder": { "type": "array", "items": { "type": "string" } },
        "servantOrderSlots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        },
        "cards": { "enum": ["buster", "arts", "quick", "balanced"] },
        "colorPriority": {
          "type": "array",
          "items": { "$ref": "#/$defs/cardColor" }
        },
        "strategyOrder": {
          "type": "array",
          "items": { "enum": ["servant", "cards", "crit"] }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["kind", "title", "detail", "icon"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["skill", "master", "spell", "attack", "target", "orderChange"] },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "icon": { "type": "string" },
        "skill": { "type": "integer", "minimum": 0 },
        "memberSlot": { "$ref": "#/$defs/slot" },
        "playerTargetSlot": { "$ref": "#/$defs/slot" },
        "enemyTarget": { "type": "integer", "minimum": 1, "maximum": 6 },
        "secondarySelection": { "$ref": "#/$defs/secondarySelection" },
        "swapOutSlot": { "$ref": "#/$defs/slot" },
        "swapInSlot": { "$ref": "#/$defs/slot" },
        "fromTarget": { "type": "integer", "minimum": 1, "maximum": 6 },
        "toTarget": { "type": "integer", "minimum": 1, "maximum": 6 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "orderChange" } }, "required": ["kind"] },
          "then": { "required": ["swapOutSlot", "swapInSlot"] }
        }
      ]
    },
    "attackCard": {
      "type": "object",
      "required": ["slot", "type"],
      "additionalProperties": false,
      "properties": {
        "slot": { "$ref": "#/$defs/slot" },
        "type": { "$ref": "#/$defs/cardColor" },
        "deckIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "attack": {
      "type": "object",
      "required": ["mode", "cards"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["strategy", "prefer", "verify"] },
        "cards": { "type": "array", "items": { "$ref": "#/$defs/attackCard" } }
      }
    },
    "turn": {
      "type": "object",
      "required": ["actions"],
      "additionalProperties": false,
      "properties": {
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "npPositions": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-5]$" },
          "additionalProperties": {
            "oneOf": [
              { "const": "auto" },
              { "type": "integer", "enum": [1, 2, 3] }
            ]
          }
        },
        "attack": { "$ref": "#/$defs/attack" }
      }
    },
    "wave": {
      "type": "object",
      "required": ["turnCount", "target", "turns"],
      "additionalProperties": false,
      "properties": {
        "turnCount": { "type": "integer", "minimum": 1 },
        "target": { "type": "integer", "minimum": 1, "maximum": 6 },
        "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string" },
    "mysticId": { "type": "string", "minLength": 1 },
    "enemyCount": { "enum": [3, 6] },
    "formation": {
      "type": "array",
      "items": { "$ref": "#/$defs/formationSlot" }
    },
    "strategy": { "$ref": "#/$defs/fallbackStrategy" },
    "strategyByWave": {
      "type": "object",
      "propertyNames": { "pattern": "^[1-3]$" },
      "additionalProperties": {
        "anyOf": [
          { "$ref": "#/$defs/fallbackStrategy" },
          { "type": "null" }
        ]
      }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/wave" }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "provenance": {}
  }
}
